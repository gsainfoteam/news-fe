# API base URL used at build time to load pages (astro:env, server)
API_BASE_URL=api_base_url

# API base URL used by browser islands (astro:env, client — must be PUBLIC_ prefixed)
PUBLIC_API_BASE_URL=api_base_url

# OpenAPI schema generation (scripts/gen-api.ts) — server-only, not exposed
SWAGGER_URL=swagger_url
SWAGGER_USER=swagger_user
SWAGGER_PASSWORD=swagger_password
