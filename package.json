    "i18n:types": "i18next-cli types",
    "i18n:status": "i18next-cli status",
    "ui:fix": "perl -pi -e 's|from \"cn\"|from \"@/common/lib/cn\"|' src/common/components/ui/*.tsx && eslint --fix src/common/components/ui"
  },
  "dependencies": {
    "@astrojs/react": "6.0.0",
