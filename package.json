    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "astro check && eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gen:api": "bun --bun openapi-ts",
    "gen:i18n": "i18next-cli extract && i18next-cli types",
