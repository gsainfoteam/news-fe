    "i18next-cli": "^1.64.2",
    "msw": "2.15.0",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^10.4.6",
    "typescript": "5",
    "typescript-eslint": "^8.62.0"
