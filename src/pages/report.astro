---
import { getPageI18n } from "@/common/lib/i18n";
import { ReportPage } from "@/features/report";
import Layout from "@/layouts/layout.astro";

const { t } = getPageI18n(Astro.currentLocale);
const title = t("report.page.title", "제보하기");
const kicker = t("report.page.kicker", "제보");
const heading = t("report.page.heading", "지스트신문에 제보하기");
const lead = t(
  "report.page.lead",
  "취재가 필요한 소식을 알려주세요. 기자가 내용을 확인한 뒤 남겨주신 연락처로 연락드릴 수 있습니다.",
);
---

<Layout title={title} description={lead}>
  <div
    class="mx-auto w-full max-w-[760px] pt-12 pb-20 mobile:pt-8 mobile:pb-14"
  >
    <div class="mb-8 flex flex-col gap-3">
      <p class="text-xs font-bold text-brand-text">{kicker}</p>
      <h1 class="text-h1">{heading}</h1>
      <p class="text-base text-muted-foreground">{lead}</p>
    </div>
    <ReportPage client:only="react" />
  </div>
</Layout>
