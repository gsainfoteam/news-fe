import { AdminArticleEditor } from "@/features/article";
import AdminLayout from "@/layouts/admin-layout.astro";

const { t } = getPageI18n(Astro.currentLocale);
const title = t("admin.editor.newTitle", "새 기사");
---

<AdminLayout title={title}>
