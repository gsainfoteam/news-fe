---
import { getRelativeLocaleUrl } from "astro:i18n";

import "@/styles/global.css";
// Initialize i18next + dayjs locale sync once for every page (server render).
import "@/common/lib/dayjs";
import { getPageI18n } from "@/common/lib/i18n";
import { LANGUAGES } from "@/common/lib/languages";

const { t } = getPageI18n(Astro.currentLocale);
const title = t("site.name", "지스트신문");
---

<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      LANGUAGES.map((lng) => (
        <link
          rel="alternate"
          hreflang={lng}
          href={getRelativeLocaleUrl(lng, Astro.url.pathname)}
        />
      ))
    }
  </head>
  <body>
    <main class="mx-auto max-w-7xl p-6">
      <slot />
    </main>
  </body>
</html>
