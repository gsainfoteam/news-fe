---
import "@/styles/global.css";
// Initialize i18next + dayjs locale sync for the island bundle.
import "@/common/lib/dayjs";
import { getPageI18n } from "@/common/lib/i18n";

interface Props {
  /** Page title; "CMS" and the site name are appended. */
  title: string;
}

const locale = Astro.currentLocale ?? "ko";
const { t } = getPageI18n(locale);
const siteName = t("site.name", "지스트신문");
const fullTitle = `${Astro.props.title} | ${t("admin.cms", "CMS")} | ${siteName}`;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- The CMS is for members only and renders nothing without a login. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="min-h-dvh bg-background">
    <slot />
  </body>
</html>
