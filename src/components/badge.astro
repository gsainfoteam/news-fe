---
import { cv } from "../lib/utils";

interface Props {
  label: string;
  variant?: "default" | "blue" | "red" | "green";
  class?: string;
}

const { label, variant = "default", class: className = "" } = Astro.props;

const badge = cv({
  base: "inline-flex items-center px-3 py-1 rounded-full text-caption-bold text-white",
  variants: {
    variant: {
      default: "bg-neutral-600",
      blue: "bg-blue-700",
      red: "bg-red-700",
      green: "bg-green-600",
    },
  },
  defaultVariants: {
    variant: "default",
  },
});
---

<span class={badge({ variant, class: className })}>
  {label}
</span>
