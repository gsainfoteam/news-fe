---
import Article from "./article.astro";
import Button from "./button.astro";
import { cn, cv } from "../lib/utils";

export interface ArticleData {
  category: string;
  title: string;
  author: string;
  publishedAt: string;
  thumbnailImage?: string;
  mainImage?: string;
  href: string;
}

interface Props {
  title?: string;
  buttonLabel?: string;
  buttonHref?: string;
  articles: ArticleData[];
  orientation?: "vertical" | "horizontal";
  class?: string;
}

const {
  title,
  buttonLabel = "Button",
  buttonHref,
  articles,
  orientation = "vertical",
  class: className = "",
} = Astro.props;

const container = cv({
  base: "flex flex-col gap-4 rounded-2xl bg-white p-5",
  variants: {
    orientation: {
      vertical: "",
      horizontal: "",
    },
  },
});

const list = cv({
  base: "flex flex-col",
  variants: {
    orientation: {
      vertical: "divide-y divide-neutral-100",
      horizontal: "grid grid-cols-1 md:grid-cols-2 gap-4",
    },
  },
});
---

<div class={container({ orientation, class: className })}>
  {
    title && (
      <div class="flex items-center justify-between">
        <h2 class="leading-tight text-neutral-900">{title}</h2>
      </div>
    )
  }

  {title && orientation === "vertical" && <div class="h-px bg-neutral-100" />}

  <div class={list({ orientation })}>
    {
      articles.map((article, idx) => (
        <div
          class={cn(
            orientation === "vertical" ? "py-4 first:pt-0 last:pb-0" : "",
          )}
        >
          <Article
            orientation={orientation}
            category={article.category}
            title={article.title}
            author={article.author}
            publishedAt={article.publishedAt}
            thumbnailImage={article.thumbnailImage}
            mainImage={article.mainImage}
            href={article.href}
          />
        </div>
      ))
    }
  </div>

  {
    buttonLabel && (
      <div class="flex justify-center">
        <Button
          label={buttonLabel}
          variant="secondary"
          rightIcon="tabler:chevron-right"
          href={buttonHref}
          class="w-full"
        />
      </div>
    )
  }
</div>
