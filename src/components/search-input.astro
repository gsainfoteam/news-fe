---
import { Icon } from "astro-icon/components";
import { cn } from "../lib/utils";

interface Props {
  placeholder?: string;
  class?: string;
}

const {
  placeholder = "뉴스 제목 또는 기자를 입력하세요",
  class: className = "",
} = Astro.props;
---

<div class={cn("relative", className)}>
  <div class="absolute top-1/2 left-3 -translate-y-1/2 transform">
    <Icon name="tabler:search" class="h-5 w-5 text-neutral-400" />
  </div>
  <input
    type="text"
    placeholder={placeholder}
    class="w-full rounded-xl border-[1.5px] border-neutral-100 bg-neutral-100 py-2 pr-4 pl-10 text-neutral-900 transition-colors placeholder:text-neutral-400 hover:border-neutral-300 hover:bg-white focus:border-neutral-400 focus:bg-white focus:outline-none"
  />
</div>
