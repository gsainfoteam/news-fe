---
import { Icon } from "astro-icon/components";

interface Props {
  placeholder?: string;
  class?: string;
}

const {
  placeholder = "뉴스 제목 또는 기자를 입력하세요",
  class: className = "",
} = Astro.props;
---

<div class={`relative ${className}`}>
  <div class="absolute top-1/2 left-3 -translate-y-1/2 transform">
    <Icon name="tabler:search" class="h-5 w-5 text-neutral-400" />
  </div>
  <input
    type="text"
    placeholder={placeholder}
    class="w-full rounded-lg border-none bg-neutral-100 py-2 pr-4 pl-10 focus:bg-white focus:ring-2 focus:ring-primary focus:outline-none"
  />
</div>
