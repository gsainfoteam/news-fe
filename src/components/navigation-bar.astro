---
interface Props {
  items: Array<{ label: string; href: string; active?: boolean }>;
}

const { items } = Astro.props;
---

<nav class="border-t border-neutral-200">
  <div class="mx-auto max-w-7xl px-6">
    <ul class="flex items-center gap-8 overflow-x-auto">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              class={`block border-b-2 py-4 text-nav text-neutral-600 transition-colors hover:text-neutral-900 ${
                item.active
                  ? "border-primary"
                  : "border-transparent hover:border-neutral-300"
              }`}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
