---
import IconButton from "./icon-button.astro";
import SearchInput from "./search-input.astro";
import NavigationBar from "./navigation-bar.astro";

const navItems = [
  { label: "대학", href: "#", active: true },
  { label: "사회", href: "#" },
  { label: "학술·연구", href: "#" },
  { label: "문화", href: "#" },
  { label: "기획·특집", href: "#" },
  { label: "현장르포", href: "#" },
  { label: "오피니언", href: "#" },
  { label: "제보하기", href: "#" },
];
---

<header class="border-b border-neutral-200 bg-white">
  <div class="mx-auto max-w-7xl px-6 py-4">
    <div class="flex items-center justify-between gap-4">
      <div class="shrink-0">
        <img src="/logo.png" width="120px" alt="지스트신문" class="h-8" />
      </div>

      <SearchInput class="max-w-2xl flex-1" />

      <div class="flex shrink-0 items-center gap-4">
        <IconButton icon="tabler:settings" label="설정" />
        <IconButton icon="tabler:user" label="사용자 계정" />
      </div>
    </div>
  </div>

  <NavigationBar items={navItems} />
</header>
