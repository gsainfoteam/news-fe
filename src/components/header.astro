---
import { Icon } from "astro-icon/components";
---

<header class="border-b border-gray-200 bg-white">
  <div class="mx-auto max-w-7xl px-6 py-4">
    <div class="flex items-center justify-between gap-4">
      <div class="shrink-0">
        <h1 class="text-2xl font-bold">
          <span class="text-red-600">지</span>
          <span class="text-gray-600">스트신문</span>
        </h1>
      </div>

      <div class="max-w-2xl flex-1">
        <div class="relative">
          <div class="absolute top-1/2 left-3 -translate-y-1/2 transform">
            <Icon name="tabler:search" class="h-5 w-5 text-gray-400" />
          </div>
          <input
            type="text"
            placeholder="뉴스 제목 또는 기자를 입력하세요"
            class="w-full rounded-lg border-none bg-gray-100 py-2 pr-4 pl-10 focus:bg-white focus:ring-2 focus:ring-red-500 focus:outline-none"
          />
        </div>
      </div>

      <div class="flex shrink-0 items-center gap-4">
        <button
          class="rounded-lg p-2 transition-colors hover:bg-gray-100"
          aria-label="설정"
        >
          <Icon name="tabler:settings" class="h-6 w-6 text-gray-600" />
        </button>
        <button
          class="rounded-lg p-2 transition-colors hover:bg-gray-100"
          aria-label="사용자 계정"
        >
          <Icon name="tabler:user" class="h-6 w-6 text-gray-600" />
        </button>
      </div>
    </div>
  </div>

  <nav class="border-t border-gray-200">
    <div class="mx-auto max-w-7xl px-6">
      <ul class="flex items-center gap-8 overflow-x-auto">
        <li>
          <a
            href="#"
            class="block border-b-2 border-red-600 py-4 text-sm font-medium text-gray-600 transition-colors hover:text-gray-900"
          >
            대학
          </a>
        </li>
        <li>
          <a
            href="#"
            class="block border-b-2 border-transparent py-4 text-sm font-medium text-gray-600 transition-colors hover:border-gray-300 hover:text-gray-900"
          >
            사회
          </a>
        </li>
        <li>
          <a
            href="#"
            class="block border-b-2 border-transparent py-4 text-sm font-medium text-gray-600 transition-colors hover:border-gray-300 hover:text-gray-900"
          >
            학술·연구
          </a>
        </li>
        <li>
          <a
            href="#"
            class="block border-b-2 border-transparent py-4 text-sm font-medium text-gray-600 transition-colors hover:border-gray-300 hover:text-gray-900"
          >
            문화
          </a>
        </li>
        <li>
          <a
            href="#"
            class="block border-b-2 border-transparent py-4 text-sm font-medium text-gray-600 transition-colors hover:border-gray-300 hover:text-gray-900"
          >
            기획·특집
          </a>
        </li>
        <li>
          <a
            href="#"
            class="block border-b-2 border-transparent py-4 text-sm font-medium text-gray-600 transition-colors hover:border-gray-300 hover:text-gray-900"
          >
            현장르포
          </a>
        </li>
        <li>
          <a
            href="#"
            class="block border-b-2 border-transparent py-4 text-sm font-medium text-gray-600 transition-colors hover:border-gray-300 hover:text-gray-900"
          >
            오피니언
          </a>
        </li>
        <li>
          <a
            href="#"
            class="block border-b-2 border-transparent py-4 text-sm font-medium text-gray-600 transition-colors hover:border-gray-300 hover:text-gray-900"
          >
            제보하기
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>
