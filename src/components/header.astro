---
import { Icon } from 'astro-icon/components';
---

<header class="bg-white border-b border-gray-200">
	<div class="max-w-7xl mx-auto px-6 py-4">
		<div class="flex items-center justify-between gap-4">
			<div class="shrink-0">
				<h1 class="text-2xl font-bold">
					<span class="text-red-600">지</span>
					<span class="text-gray-600">스트신문</span>
				</h1>
			</div>

			<div class="flex-1 max-w-2xl">
				<div class="relative">
					<div class="absolute left-3 top-1/2 transform -translate-y-1/2">
						<Icon name="tabler:search" class="w-5 h-5 text-gray-400" />
					</div>
					<input
						type="text"
						placeholder="뉴스 제목 또는 기자를 입력하세요"
						class="w-full pl-10 pr-4 py-2 bg-gray-100 rounded-lg border-none focus:outline-none focus:ring-2 focus:ring-red-500 focus:bg-white"
					/>
				</div>
			</div>

			<div class="flex items-center gap-4 shrink-0">
				<button
					class="p-2 hover:bg-gray-100 rounded-lg transition-colors"
					aria-label="설정"
				>
					<Icon name="tabler:settings" class="w-6 h-6 text-gray-600" />
				</button>
				<button
					class="p-2 hover:bg-gray-100 rounded-lg transition-colors"
					aria-label="사용자 계정"
				>
					<Icon name="tabler:user" class="w-6 h-6 text-gray-600" />
				</button>
			</div>
		</div>
	</div>

	<nav class="border-t border-gray-200">
		<div class="max-w-7xl mx-auto px-6">
			<ul class="flex items-center gap-8 overflow-x-auto">
				<li>
					<a
						href="#"
						class="block py-4 text-gray-600 border-b-2 border-red-600 text-sm font-medium hover:text-gray-900 transition-colors"
					>
						대학
					</a>
				</li>
				<li>
					<a
						href="#"
						class="block py-4 text-gray-600 border-b-2 border-transparent text-sm font-medium hover:text-gray-900 hover:border-gray-300 transition-colors"
					>
						사회
					</a>
				</li>
				<li>
					<a
						href="#"
						class="block py-4 text-gray-600 border-b-2 border-transparent text-sm font-medium hover:text-gray-900 hover:border-gray-300 transition-colors"
					>
						학술·연구
					</a>
				</li>
				<li>
					<a
						href="#"
						class="block py-4 text-gray-600 border-b-2 border-transparent text-sm font-medium hover:text-gray-900 hover:border-gray-300 transition-colors"
					>
						문화
					</a>
				</li>
				<li>
					<a
						href="#"
						class="block py-4 text-gray-600 border-b-2 border-transparent text-sm font-medium hover:text-gray-900 hover:border-gray-300 transition-colors"
					>
						기획·특집
					</a>
				</li>
				<li>
					<a
						href="#"
						class="block py-4 text-gray-600 border-b-2 border-transparent text-sm font-medium hover:text-gray-900 hover:border-gray-300 transition-colors"
					>
						현장르포
					</a>
				</li>
				<li>
					<a
						href="#"
						class="block py-4 text-gray-600 border-b-2 border-transparent text-sm font-medium hover:text-gray-900 hover:border-gray-300 transition-colors"
					>
						오피니언
					</a>
				</li>
				<li>
					<a
						href="#"
						class="block py-4 text-gray-600 border-b-2 border-transparent text-sm font-medium hover:text-gray-900 hover:border-gray-300 transition-colors"
					>
						제보하기
					</a>
				</li>
			</ul>
		</div>
	</nav>
</header>
