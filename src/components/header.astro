---
import IconButton from "./icon-button.astro";
import SearchInput from "./search-input.astro";
import NavigationBar from "./navigation-bar.astro";
import { CATEGORIES } from "../lib/constants";

const currentPath = Astro.url.pathname;

const navItems = CATEGORIES.map((category) => ({
  label: category.label,
  href: `/${category.slug}`,
  slug: category.slug,
  active: currentPath === `/${category.slug}`,
}));
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-neutral-200 bg-white/90 backdrop-blur-md transition-transform duration-200 ease-out will-change-transform"
>
  <div class="mx-auto max-w-7xl px-6 py-4" data-header-main>
    <div class="flex items-center justify-between gap-4">
      <div class="flex shrink-0 items-center">
        <a
          href="/"
          aria-label="홈으로 이동"
          class="inline-block cursor-pointer rounded-md focus-visible:ring-2 focus-visible:ring-neutral-300 focus-visible:outline-none"
        >
          <img src="/logo.png" width="120px" alt="지스트신문" class="block" />
        </a>
      </div>

      <SearchInput class="max-w-2xl flex-1" />

      <div class="flex shrink-0 items-center gap-4">
        <IconButton icon="tabler:settings" label="설정" />
        <IconButton icon="tabler:user" label="사용자 계정" />
      </div>
    </div>
  </div>

  <div data-header-nav>
    <NavigationBar items={navItems} />
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const main = header.querySelector(
      "[data-header-main]",
    ) as HTMLElement | null;
    const hideOffsetPx = main?.offsetHeight ?? 72;
    const thresholdPx = 6;

    const update = () => {
      const y = window.scrollY;
      const delta = y - lastY;

      if (y <= 0) {
        // 페이지 최상단
        header.style.transform = "translateY(0)";
      } else if (delta > thresholdPx) {
        // 아래로 스크롤
        header.style.transform = `translateY(-${hideOffsetPx}px)`;
      } else if (delta < -thresholdPx) {
        // 위로 스크롤
        header.style.transform = "translateY(0)";
      }

      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
  }
</script>
