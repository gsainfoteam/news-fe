---
import { Icon } from "astro-icon/components";
import { cv } from "../lib/utils";

interface Props {
  label: string;
  variant?: "primary" | "secondary" | "outline";
  leftIcon?: string;
  rightIcon?: string;
  href?: string;
  class?: string;
}

const {
  label,
  variant = "outline",
  leftIcon,
  rightIcon,
  href,
  class: className = "",
} = Astro.props;

const button = cv({
  base: "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-button transition-colors focus:outline-none",
  variants: {
    variant: {
      primary:
        "bg-neutral-800 text-white border-transparent hover:bg-neutral-900",
      secondary:
        "bg-neutral-100 text-neutral-900 border-transparent hover:bg-neutral-200",
      outline:
        "bg-neutral-100 text-neutral-900 border-[1.5px] border-neutral-900 hover:border-neutral-300 hover:bg-white",
    },
  },
  defaultVariants: {
    variant: "outline",
  },
});

const iconStyles = cv({
  base: "h-5 w-5",
  variants: {
    variant: {
      primary: "text-white",
      secondary: "text-neutral-900",
      outline: "text-neutral-900",
    },
  },
});
---

{
  href ? (
    <a href={href} class={button({ variant, class: className })}>
      {leftIcon && <Icon name={leftIcon} class={iconStyles({ variant })} />}
      <span>{label}</span>
      {rightIcon && <Icon name={rightIcon} class={iconStyles({ variant })} />}
    </a>
  ) : (
    <button class={button({ variant, class: className })}>
      {leftIcon && <Icon name={leftIcon} class={iconStyles({ variant })} />}
      <span>{label}</span>
      {rightIcon && <Icon name={rightIcon} class={iconStyles({ variant })} />}
    </button>
  )
}
